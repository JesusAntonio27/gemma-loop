# Canonical ignore list for the Gemma-Loop image.
# Docker only reads the ignore file at the build-context root, so
# ../.dockerignore mirrors this list; keep the two files in sync.
#
# Virtual environments, caches and local ledgers
.venv*
**/.venv*
artifacts
artifacts/
**/artifacts/
.superpowers
.superpowers/
**/.superpowers/
__pycache__/
**/__pycache__/
*.py[cod]
**/*.py[cod]
.pytest_cache/
**/.pytest_cache/
.mypy_cache/
**/.mypy_cache/
.ruff_cache/
**/.ruff_cache/
.oc/
**/.oc/
*.egg-info/
**/*.egg-info/
*.log
**/*.log
.git/
.gitignore
#
# Secrets: never bake credentials into the image.  Pass HF_TOKEN at runtime.
.env*
**/.env*
*.pem
**/*.pem
*.key
**/*.key
*.p12
**/*.p12
.netrc
**/.netrc
*token*
**/*token*
credentials*
**/credentials*
.aws/
**/.aws/
.huggingface/
**/.huggingface/
.cache/
**/.cache/
#
# Model weights and run outputs (mounted through /cache and /artifacts)
*.safetensors
**/*.safetensors
*.bin
**/*.bin
*.gguf
**/*.gguf
*.pt
**/*.pt
*.pth
**/*.pth
*.ckpt
**/*.ckpt
checkpoints
checkpoints/
**/checkpoints/
wandb/
**/wandb/
runs/
**/runs/
outputs/
**/outputs/
